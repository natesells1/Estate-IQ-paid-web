# Public site URL, used for the sitemap and canonical links
SITE_URL=https://estateiq.example.com

# Postgres. Railway sets this when you link the Postgres service.
# Leave unset locally to use the embedded database in .data/
DATABASE_URL=

# Stripe (test keys first: sk_test_... and whsec_...). Set these in Railway, never commit them.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
